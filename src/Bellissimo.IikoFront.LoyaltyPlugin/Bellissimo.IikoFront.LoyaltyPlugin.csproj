<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Bellissimo.IikoFront.LoyaltyPlugin</RootNamespace>
    <AssemblyName>Bellissimo.IikoFront.LoyaltyPlugin</AssemblyName>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="Resto.Front.Api.V8">
      <HintPath>..\..\libs\Resto.Front.Api.V8.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Manifest.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="EnsureIikoFrontApiDllExists" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(MSBuildThisFileDirectory)..\..\libs\Resto.Front.Api.V8.dll')"
      Text="Missing iikoFront API DLL. Copy Resto.Front.Api.V8.dll to the repository libs directory before building." />
  </Target>
</Project>
